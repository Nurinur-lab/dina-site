# Адрес сайта (для canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://example.ru

# Яндекс.Метрика (необязательно; подключается только после согласия на cookie)
NEXT_PUBLIC_YM_ID=

# Почта для формы (SMTP российского провайдера: Яндекс 360, VK WorkSpace и т. п.)
# Если SMTP_HOST пуст — письма пишутся в лог сервера.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Сайт «Дины» <noreply@example.ru>"
MAIL_TO=

# Деплой (используются deploy/deploy.sh)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_DOMAIN=
LETSENCRYPT_EMAIL=
